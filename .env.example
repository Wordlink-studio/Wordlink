# WORDLINK 환경변수 예시
# Render 대시보드 > Environment Variables 에 등록하세요.

# --- Firebase (선택, 권장) ---
# Firestore에 레벨·전적 데이터를 영구 저장합니다.
# 방법 A: 서비스 계정 JSON 전체를 하나의 환경변수로 넣기 (권장)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@iam.gserviceaccount.com",...}

# 방법 B: 각각의 환경변수로 넣기
# FIREBASE_PROJECT_ID=wordlink-xxxx
# FIREBASE_CLIENT_EMAIL=wordlink-xxxx@iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firestore 컬렉션 이름 (기본: profiles)
FIRESTORE_COLLECTION=profiles

# --- PostgreSQL (선택, Firebase 대신 사용 가능) ---
# DATABASE_URL=postgresql://user:pass@host:5432/db

# --- 세션 ---
# SESSION_SECRET=최소 32자리 임의 문자열 (운영 필수, 재시작 시 유지해야 로그인 상태가 유지됨)

# --- 소셜 로그인 (설정한 제공자만 로그인 버튼 노출) ---
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...

# --- 공개 URL (배포 주소, OAuth 콜백용) ---
# PUBLIC_URL=https://wordlink.onrender.com